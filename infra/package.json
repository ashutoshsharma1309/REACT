{
  "name": "react-infra",
  "version": "0.6.0",
  "private": true,
  "description": "REACT AWS infrastructure (AWS CDK v2, TypeScript). The only IaC framework in this repository.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth --quiet",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "aws-cdk-lib": "2.271.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "aws-cdk": "2.1143.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
