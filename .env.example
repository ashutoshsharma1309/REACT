# ---- REACT configuration (local development). Copy to .env; never commit .env. ----
APP_NAME=REACT
# local | development | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# Database (docker-compose overrides host to "postgres")
DATABASE_URL=postgresql+psycopg://react:react@localhost:5432/react
# Used only by pytest (falls back to DATABASE_URL + "_test" if unset)
TEST_DATABASE_URL=postgresql+psycopg://react:react@localhost:5432/react_test

# Create schema automatically at startup (dev convenience; Alembic is the source of truth)
AUTO_CREATE_SCHEMA=true
# Seed the synthetic dataset automatically if the database is empty
SEED_ON_STARTUP=true

# Synthetic data generation (deterministic)
SEED=42
HISTORY_DAYS=120
SENSOR_INTERVAL_MINUTES=60

# Redis is not used by REACT (no cache or queue is needed yet). Left unset on purpose.
# REDIS_URL=

# ---- Phase 3: agentic layer ----
AGENTS_ENABLED=true
# deterministic = rule-based provider (no LLM, always available) | bedrock = Amazon Bedrock | mock = tests only
LLM_PROVIDER=deterministic
# Required only when LLM_PROVIDER=bedrock: the Bedrock model ID or inference-profile ID enabled in YOUR account and region
# (copy it from the Bedrock console). No default is built in. If it is missing, REACT treats the model as unavailable.
LLM_MODEL=
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
AWS_REGION=us-east-1
# AWS credentials come from the standard boto3 chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env, profile or IAM role). Never commit them.
AGENT_MAX_ITERATIONS=4
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_LLM_CALLS=10
AGENT_MAX_EXECUTION_SECONDS=120
AGENT_FALLBACK_TO_DETERMINISTIC=true

# ---- Phase 5: product UI ----
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# ---- Phase 6: cloud deployment (the defaults below are the LOCAL settings) ----
# On ECS these are set by the CDK stack; DB_USER / DB_PASSWORD are injected from AWS Secrets Manager, never written here.
# DB_HOST=            # when set, DATABASE_URL is composed from DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD
# DB_PORT=5432
# DB_NAME=react
# DB_SSLMODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# local (directory) | s3 (needs ARTIFACTS_BUCKET and an IAM role with access to the evidence-packs/ prefix)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/artifacts
# ARTIFACTS_BUCKET=
ARTIFACTS_PREFIX=evidence-packs/
# CloudWatch Embedded Metric Format lines on stdout (enable on AWS only)
METRICS_ENABLED=false
METRICS_NAMESPACE=REACT
# CloudFront forwards /api/* unchanged; the API strips this prefix
API_PATH_PREFIX=/api
# Cost guard: real LLM calls per rolling hour across all API containers
LLM_HOURLY_CALL_BUDGET=200
# POST /demo/ai-outage (AI-failure drill). Set false in production.
DEMO_CONTROLS_ENABLED=true
# Container only: run "alembic upgrade head" at start, and uvicorn worker count
# RUN_MIGRATIONS=true
# WEB_CONCURRENCY=2
